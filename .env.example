# Azure OpenAI Configuration - Model 1 (nano)
AZURE_OPENAI_KEY=your_azure_openai_api_key_here
DEPLOYMENT1_NAME=your_deployment_name_nano
MODEL1_NAME=gpt-4.1-nano
AZURE_OPENAI_ENDPOINT1=https://your-resource.openai.azure.com/

# Azure OpenAI Configuration - Model 2 (mini)
DEPLOYMENT2_NAME=your_deployment_name_mini
MODEL2_NAME=gpt-4.1-mini
AZURE_OPENAI_ENDPOINT2=https://your-resource.openai.azure.com/

# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# A role with SELECT only, used for every query and value lookup the app runs. Falls back to
# DATABASE_URL above when left unset. See docs/READ_ONLY_ROLE.md for how to create the role.
DATABASE_URL_RO=postgresql://readonly_username:password@host:port/database?sslmode=require

# Only read by docker-compose.local-db.yml, which creates a local Chinook database for
# development and sets these as the superuser password and the read-only role's password.
# That same file also points DATABASE_URL and DATABASE_URL_RO above at this database once it
# is layered on: see the "Getting started" section of README.md.
POSTGRES_PASSWORD=chinook_local_dev
CHINOOK_RO_PASSWORD=chinook_ro_local_dev
POSTGRES_PORT=55432

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=schema_tables

# Where Ollama is reachable. Only needs setting when Ollama runs somewhere other than
# alongside the app itself.
OLLAMA_HOST=http://127.0.0.1:11434

# The embedding model Ollama serves, and the vector size it produces. Only needs setting
# when using a model other than nomic-embed-text; changing this after tables have already
# been indexed needs a full reindex, since the old vectors were a different size.
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Whether the terminal CLI checks the index at startup. Ignored by the web app, which never
# indexes on its own; see docker-compose.yml's "indexer" service.
AUTO_INDEX_ON_STARTUP=true

# The port docker-compose.yml's "app" service publishes on the host. Ignored everywhere else.
PORT=8501

# Optional: a single shared passphrase gate for a small evaluation audience. Leave unset to
# disable the login screen entirely.
APP_PASSPHRASE=

# Optional: how many questions one browser session, and the app as a whole, may ask per
# minute before being asked to slow down.
RATE_LIMIT_PER_SESSION_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=60