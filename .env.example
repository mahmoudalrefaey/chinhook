# Azure OpenAI Configuration - Model 1 (nano)
AZURE_OPENAI_KEY=your_azure_openai_api_key_here
DEPLOYMENT1_NAME=your_deployment_name_nano
MODEL1_NAME=gpt-4.1-nano
AZURE_OPENAI_ENDPOINT1=https://your-resource.openai.azure.com/

# Azure OpenAI Configuration - Model 2 (mini)
DEPLOYMENT2_NAME=your_deployment_name_mini
MODEL2_NAME=gpt-4.1-mini
AZURE_OPENAI_ENDPOINT2=https://your-resource.openai.azure.com/

# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=schema_tables

# Indexing Configuration
INDEX_CHECK_INTERVAL=300
AUTO_INDEX_ON_STARTUP=true