# Settings for whoever runs this deployment. Databases and models are NOT configured here:
# every visitor enters their own on the app's setup screen, and they are never stored.
# Copy this file to .env for local development; on a hosting platform, set these as the
# service's environment variables instead.

# ---------- Qdrant ----------
# Where the vector index lives. docker-compose.yml sets this for you when running locally.
QDRANT_URL=http://localhost:6333
# The API key Qdrant itself is configured with (QDRANT__SERVICE__API_KEY). Leave empty only
# for a local Qdrant that nothing else can reach.
QDRANT_API_KEY=
# Every collection this app creates starts with this, so a shared Qdrant stays tidy.
QDRANT_COLLECTION_PREFIX=chinhook

# ---------- Embedding ----------
# Runs in-process through fastembed, so visitors only need a chat model. Changing it is safe:
# indexes built with another model are simply rebuilt.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---------- Indexing ----------
# Days an index nobody has used is kept before it is deleted. 0 keeps indexes forever.
INDEX_RETENTION_DAYS=7
# Databases with more tables and views than this are refused rather than indexed.
MAX_INDEX_TABLES=200
# How many databases may be indexing at the same time on this server.
MAX_CONCURRENT_INDEX_JOBS=2

# ---------- Network ----------
# Local development only: allows connecting to databases and models on localhost or a
# private network. Must stay false on any deployment reachable from the internet.
ALLOW_PRIVATE_HOSTS=false

# ---------- Access and rate limiting ----------
# Optional shared passphrase in front of the whole app. Empty means no login screen.
APP_PASSPHRASE=
RATE_LIMIT_PER_SESSION_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=120

# ---------- Sample database (docker-compose.local-db.yml only) ----------
POSTGRES_PASSWORD=chinook_local_dev
CHINOOK_RO_PASSWORD=chinook_ro_local_dev
POSTGRES_PORT=55432

# Host port docker-compose.yml publishes the app on.
APP_PORT=8501
