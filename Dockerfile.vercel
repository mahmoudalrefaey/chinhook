# The same image as Dockerfile, for Vercel: Vercel only builds a container from a file with
# this exact name at the project root. See docs/DEPLOYMENT.md for what running on Vercel
# changes compared with an always-on container host.

FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"
ENV PYTHONUNBUFFERED=1 \
    FASTEMBED_CACHE_PATH=/app/.cache/fastembed \
    HF_HUB_DISABLE_TELEMETRY=1

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# The embedding model is baked into the image, then the Hugging Face hub is switched off so a
# cold start loads it from disk instead of first asking the internet whether it changed.
ARG EMBED_MODEL=BAAI/bge-small-en-v1.5
ENV EMBED_MODEL=${EMBED_MODEL}
RUN /app/.venv/bin/python -c "import os; from fastembed import TextEmbedding; TextEmbedding(os.environ['EMBED_MODEL'], cache_dir=os.environ['FASTEMBED_CACHE_PATH'])"
ENV HF_HUB_OFFLINE=1

COPY . .

RUN useradd --create-home --uid 1000 appuser \
    && chown -R appuser:appuser /app
USER appuser

# Vercel sends traffic to port 80 unless the project has a PORT environment variable. This
# image runs as a non-root user, which cannot bind port 80, so set PORT=8501 in the Vercel
# project: Vercel then routes to 8501 and Streamlit listens on it.
EXPOSE 8501

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sh", "-c", "exec /app/.venv/bin/streamlit run app.py --server.port \"${PORT:-8501}\" --server.address 0.0.0.0 --server.headless true"]
